{
  "name": "sen-contraventions",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/admin-web",
    "openapi": "npm run openapi -w apps/api",
    "build": "npm run build -w api && npm run build -w admin-web",
    "start:api": "npm run start -w api",
    "start:web": "npm run start -w admin-web"
  }
}
