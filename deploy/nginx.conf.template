# SEN Contraventions — bloc Nginx dédié (port __PUBLIC_PORT__), indépendant des autres sites.
# Admin Web et API sous la même origine : les appels du front sont relatifs (/v1, /ws).

upstream sen_api { server 127.0.0.1:__API_PORT__; keepalive 16; }
upstream sen_web { server 127.0.0.1:__WEB_PORT__; keepalive 16; }

server {
    listen __PUBLIC_PORT__;
    listen [::]:__PUBLIC_PORT__;
    server_name __PUBLIC_HOST__ _;

    client_max_body_size 10m;   # photos preuves / CNI (8 Mo max côté API)

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # API REST + Swagger + webhooks opérateurs + fichiers uploadés
    location ~ ^/(v1|docs|uploads)(/|$) {
        proxy_pass http://sen_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;    # exports Excel / PDF
    }

    # Temps réel (Socket.IO, namespace /ws)
    location /socket.io/ {
        proxy_pass http://sen_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Fichiers statiques Next.js (cache long, noms versionnés)
    location /_next/static/ {
        proxy_pass http://sen_web;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    # Admin Web
    location / {
        proxy_pass http://sen_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}
